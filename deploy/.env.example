# =============================================================================
# Sub2API Docker Environment Configuration
# =============================================================================
# Quick start:
#   cp .env.example .env
#   docker compose up -d
#
# Set the required blank secrets before starting. Generate random values with:
#   openssl rand -hex 32
# =============================================================================

# Application image. Leave commented to use ghcr.io/is7qin/sub2api:latest.
# SUB2API_IMAGE=ghcr.io/is7qin/sub2api
# SUB2API_VERSION=latest

# Published HTTP endpoint. These do not change the application's internal port.
PUBLISH_HOST=0.0.0.0
PUBLISH_PORT=8080

# Timezone used by the application, PostgreSQL, and Redis.
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# PostgreSQL (DATABASE_PASSWORD is required)
# -----------------------------------------------------------------------------
DATABASE_USER=sub2api
DATABASE_PASSWORD=
DATABASE_DBNAME=sub2api

# Optional PostgreSQL server tuning. Blank or unset values preserve the
# postgres:18 image defaults; uncomment only the specific overrides you need.
# POSTGRES_MAX_CONNECTIONS=
# POSTGRES_SHARED_BUFFERS=
# POSTGRES_EFFECTIVE_CACHE_SIZE=
# POSTGRES_MAINTENANCE_WORK_MEM=

# Optional application connection-pool tuning (backend defaults shown).
# DATABASE_MAX_OPEN_CONNS=256
# DATABASE_MAX_IDLE_CONNS=128
# DATABASE_CONN_MAX_LIFETIME_MINUTES=30
# DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Leave empty to run Redis without authentication.
REDIS_PASSWORD=
# Redis server policy for this managed deployment.
REDIS_MAXCLIENTS=10000

# Optional application Redis tuning (backend defaults shown).
# REDIS_DB=0
# REDIS_POOL_SIZE=1024
# REDIS_MIN_IDLE_CONNS=128
# REDIS_ENABLE_TLS=false

# -----------------------------------------------------------------------------
# Initial admin and persistent application secrets
# -----------------------------------------------------------------------------
# Leave ADMIN_PASSWORD empty to generate it on first startup and print it in logs.
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# JWT_SECRET is optional during initial auto-setup: a blank value is generated and
# persisted in /app/data/config.yaml. Set one explicitly when managing it externally.
JWT_SECRET=

# Required: set one fixed random TOTP_ENCRYPTION_KEY before starting. A blank key
# is only generated in process memory and is not safely persisted; changing it
# invalidates existing TOTP registrations and other encrypted application data.
TOTP_ENCRYPTION_KEY=

# Optional authentication lifetime tuning (backend defaults shown).
# JWT_EXPIRE_HOUR=24
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# Optional logging tuning (backend defaults shown).
# LOG_FORMAT=console
# LOG_SERVICE_NAME=sub2api
# LOG_ENV=production
# LOG_CALLER=true
# LOG_STACKTRACE_LEVEL=error
# LOG_OUTPUT_TO_STDOUT=true
# LOG_OUTPUT_TO_FILE=true
# LOG_OUTPUT_FILE_PATH=
# LOG_ROTATION_MAX_SIZE_MB=100
# LOG_ROTATION_MAX_BACKUPS=10
# LOG_ROTATION_MAX_AGE_DAYS=7
# LOG_ROTATION_COMPRESS=true
# LOG_ROTATION_LOCAL_TIME=true
# LOG_SAMPLING_ENABLED=false
# LOG_SAMPLING_INITIAL=100
# LOG_SAMPLING_THEREAFTER=100

# -----------------------------------------------------------------------------
# Dashboard aggregation retention policy
# -----------------------------------------------------------------------------
DASHBOARD_AGGREGATION_RETENTION_USAGE_LOGS_DAYS=90
DASHBOARD_AGGREGATION_RETENTION_USAGE_BILLING_DEDUP_DAYS=365
# Optional retention windows (backend defaults shown).
# DASHBOARD_AGGREGATION_RETENTION_HOURLY_DAYS=180
# DASHBOARD_AGGREGATION_RETENTION_DAILY_DAYS=730

# Optional aggregation scheduling (backend defaults shown).
# DASHBOARD_AGGREGATION_ENABLED=true
# DASHBOARD_AGGREGATION_INTERVAL_SECONDS=60
# DASHBOARD_AGGREGATION_LOOKBACK_SECONDS=120
# DASHBOARD_AGGREGATION_BACKFILL_ENABLED=false
# DASHBOARD_AGGREGATION_BACKFILL_MAX_DAYS=31
# DASHBOARD_AGGREGATION_RECOMPUTE_DAYS=2

# -----------------------------------------------------------------------------
# Optional application tuning
# -----------------------------------------------------------------------------
# Uncomment only when intentionally overriding backend defaults.
# SERVER_MODE=release
# RUN_MODE=standard
# SERVER_MAX_REQUEST_BODY_SIZE=268435456
# SERVER_H2C_ENABLED=false
# SERVER_H2C_MAX_CONCURRENT_STREAMS=50
# SERVER_H2C_IDLE_TIMEOUT=75
# SERVER_H2C_MAX_READ_FRAME_SIZE=1048576
# SERVER_H2C_MAX_UPLOAD_BUFFER_PER_CONNECTION=2097152
# SERVER_H2C_MAX_UPLOAD_BUFFER_PER_STREAM=524288
# RATE_LIMIT_OVERLOAD_COOLDOWN_MINUTES=10
# GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
# GATEWAY_OPENAI_HTTP2_ENABLED=true
# GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
# GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
# GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
# GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
# GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
# GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
# GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
# GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
# GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=reject
# GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30
# GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_SCOPES=
# GEMINI_QUOTA_POLICY=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_USER_AGENT_VERSION=
# UPDATE_PROXY_URL=
